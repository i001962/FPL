{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fpl-league-shop-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "fpl-shop.d33m.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/health"]
  },
  "vars": {
    "FPL_API_BASE": "https://fantasy.premierleague.com/api"
  }
}
