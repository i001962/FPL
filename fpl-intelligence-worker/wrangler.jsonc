{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fpl-intelligence-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "fpl.d33m.com", "custom_domain": true }],
  "vars": {
    "FPL_API_BASE": "https://fantasy.premierleague.com/api",
    "FPL_CACHE_TTL_SECONDS": "120"
  },
  "durable_objects": {
    "bindings": [{ "name": "PAYMENT_RECEIPTS", "class_name": "PaymentReceipt" }]
  },
  "exports": {
    "PaymentReceipt": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
